{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "class-swap",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*"
    ],
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "class-swap-db",
      "database_id": "d4e9d2e3-35cb-475f-b128-c78d714cd354",
      "migrations_dir": "migrations"
    }
  ],
  "account_id": "965071bae1ca798003675034b0ce7ce5"
}
